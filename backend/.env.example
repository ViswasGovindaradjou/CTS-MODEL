# Application Configuration
PROJECT_NAME="Chronic Disease Health Monitoring Platform"
JWT_SECRET_KEY="replace_with_a_secure_random_32_character_secret_key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Local SQLite default, or AWS RDS / PostgreSQL)
DATABASE_URL="sqlite:///./health_platform.db"
# For AWS RDS PostgreSQL deployment:
# DATABASE_URL="postgresql://username:password@rds-instance-endpoint.rds.amazonaws.com:5432/healthdb"

# AWS Configuration
AWS_DATABASE_TYPE="sqlite" # options: sqlite, rds_postgres, rds_mysql, dynamodb
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"

# Groq API Configuration (for AI recommendations & multilingual chatbot)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"
